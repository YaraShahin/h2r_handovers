<?xml version="1.0"?>
<launch>
  <include file="$(find-pkg-share realsense2_camera)/launch/rs_launch.py">
    <arg name="camera_name"      value="camera"/>
    <arg name="camera_namespace" value="camera"/>

    <arg name="enable_color" value="true"/>
    <arg name="enable_depth" value="true"/>

    <arg name="rgb_camera.color_profile"   value="640,480,30"/>
    <arg name="depth_module.depth_profile" value="640,480,30"/>

    <arg name="align_depth.enable" value="true"/>
    <arg name="pointcloud.enable"  value="true"/>

    <arg name="enable_infra1" value="false"/>
    <arg name="enable_infra2" value="false"/>
  </include>

  <include file="$(find-pkg-share franka_moveit_config)/launch/moveit.launch.py">
    <arg name="robot_ip" value="172.16.0.2"/>
  </include>

  <!-- <node pkg="h2r_handovers" exec="hand_stabilization_node" name="hand_stabilization_node" output="screen"/> -->
  <!-- <node pkg="h2r_handovers" exec="trigger_node" name="trigger_node" output="screen"/> -->

  <node pkg="h2r_handovers" exec="grasp_selection_node" name="grasp_selection_node" output="screen">
    <param from="$(find-pkg-share h2r_handovers)/config/handover_params.yaml" />
  </node>

  <node pkg="h2r_handovers" exec="handover_orchestrator" name="handover_orchestrator" output="screen">
    <param from="$(find-pkg-share h2r_handovers)/config/handover_params.yaml" />
  </node>

  <!-- Camera Calibration Static TFs (from panda_hand to camera_link) -->
  <node pkg="tf2_ros" exec="static_transform_publisher" name="hand_to_cameraTemp" 
        args="0.07085917397 0.03292617131 0.05131155109 -0.00814520629 0.0006262179598 -0.7175730906 0.6964352971 panda_hand camera_link_temp" />
  <node pkg="tf2_ros" exec="static_transform_publisher" name="cameraTemp_to_camera" 
        args="0.015 0.001 0 0.5 -0.5 0.5 0.5 camera_link_temp camera_link" />
</launch>